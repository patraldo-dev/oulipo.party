// oulipo.party — deploy configuration for both environments.
//
// Production is the top level. Staging repeats everything, because a wrangler
// environment replaces bindings and variables wholesale instead of adding to
// them. Secrets live on each Worker, not here: BETTER_AUTH_SECRET and the
// OAuth client secrets (GOOGLE_CLIENT_SECRET, GITHUB_CLIENT_SECRET,
// DISCORD_CLIENT_SECRET), set with `wrangler secret put NAME [--env staging]`.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"build": {
		"command": "node node_modules/vite/bin/vite.js build"
	},
	"name": "oulipo-party",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2025-09-13",
	"compatibility_flags": ["nodejs_als", "nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	"routes": [{ "pattern": "oulipo.party", "custom_domain": true }],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "oulipo-party",
			"database_id": "9d674250-f49f-4ab8-9d86-084cfd94907d"
		}
	],
	"ai": {
		"binding": "AI"
	},
	// Transactional mail (sign-up verification, password reset) goes through
	// Cloudflare's Email Sending from this domain. No key: the binding is it.
	"send_email": [{ "name": "EMAIL" }],
	"vars": {
		"BETTER_AUTH_URL": "https://oulipo.party",
		"EMAIL_FROM": "oulipo.party <noreply@oulipo.party>",
		// A provider is offered only when its id and its secret are both set
		// (the secrets are set apart, see the note above). Google and Discord
		// both allow an application several return addresses, so this is the
		// project and the application the ambientx accounts site already uses,
		// with this site's two addresses to be added to each. A GitHub OAuth
		// application allows exactly one return address, so GitHub needs an
		// application of this site's own.
		"GOOGLE_CLIENT_ID": "186062141805-7qc8lhn4p9t57bmrh4b0s54v6145haan.apps.googleusercontent.com",
		"GITHUB_CLIENT_ID": "",
		"DISCORD_CLIENT_ID": "1535696170540863588"
	},
	"env": {
		"staging": {
			// The workers.dev address serves the pages, but the sign-in library
			// only answers on the origin it is configured for, so signing in
			// works on staging.oulipo.party alone.
			"workers_dev": true,
			"routes": [{ "pattern": "staging.oulipo.party", "custom_domain": true }],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "oulipo-party-staging",
					"database_id": "2e0b993c-88ef-437c-86b1-fed92c556c41"
				}
			],
			"ai": {
				"binding": "AI"
			},
			"send_email": [{ "name": "EMAIL" }],
			"vars": {
				"BETTER_AUTH_URL": "https://staging.oulipo.party",
				"EMAIL_FROM": "oulipo.party (staging) <staging@oulipo.party>",
				"GOOGLE_CLIENT_ID": "186062141805-7qc8lhn4p9t57bmrh4b0s54v6145haan.apps.googleusercontent.com",
				"GITHUB_CLIENT_ID": "",
				"DISCORD_CLIENT_ID": "1535696170540863588"
			}
		}
	}
}
